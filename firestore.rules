rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No login: anyone with the page can read and write the club's three data sets, nothing else.
    match /club/settings {
      allow read, write: if true;
    }
    match /loaves/{id} {
      allow read, write: if true;
    }
    match /slices/{id} {
      allow read, write: if true;
    }
  }
}
